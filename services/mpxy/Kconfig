config MPXY
	bool "Message proxy channels (SBI MPXY extension)"
	depends on SBI
	help
	  Lets S-mode exchange messages with a message protocol implementation
	  through the monitor: per-hart shared memory, channels with
	  attributes, messages with and without response, notification
	  events. Channels come from the message protocols below.

if MPXY

config MPXY_SSE_EVENTS
	int "Channels that can signal notification events through SSE"
	range 0 64
	default 8 if SBI_SSE
	default 0
	help
	  Each such channel gets a platform specific global software event
	  (0x0010c000 up), in the order the channels are found, which is
	  raised when the channel has notification events to fetch. S-mode
	  reads the event id from the channel's SSE_EVENT_ID attribute. An
	  MSI, which S-mode sets up through the channel attributes and which
	  takes no support from the platform, is preferred when both are on.

config MPXY_RPMI
	bool "RPMI service groups as MPXY channels"
	depends on RPMI
	default y
	help
	  One channel per RPMI service group the platform opens to S-mode
	  (system MSI, voltage, clock, device power, performance, management
	  mode, RAS agent, request forward, or a group of the platform's
	  own), forwarded to the platform microcontroller once the request
	  is a well-formed one of the group. The channels are the
	  "riscv,rpmi-mpxy-*" nodes of the device tree.

config MPXY_RPMI_FW
	bool "RPMI service groups served by the monitor"
	depends on DOMAINS
	default y
	help
	  RPMI over MPXY without a platform microcontroller behind it, for
	  what is the SBI implementation's to do: forwarding requests from
	  one domain to another. "riscv,rpmi-mpxy-request-forward" nodes
	  without "mboxes" are the REQUEST_FORWARD channels through which a
	  domain takes the requests forwarded to it and answers them;
	  "riscv,rpmi-mpxy-mm-domain" nodes are MANAGEMENT_MODE channels
	  whose MM_COMMUNICATE requests are forwarded to the domain that
	  hosts the management mode.

config MPXY_RPMI_FW_MAX_CHANNELS
	int "Maximum number of channels served by the monitor"
	depends on MPXY_RPMI_FW
	default 4

config MPXY_RPMI_MAX_CHANNELS
	int "Maximum number of RPMI channels"
	depends on MPXY_RPMI
	default 8

config MPXY_RPMI_MAX_SYSMSI
	int "Most system MSIs of a PuC"
	depends on MPXY_RPMI
	default 128
	help
	  The SYSTEM_MSI service group: the monitor keeps the MSIs that are
	  M-mode's, and the transport's P2A doorbell, away from S-mode. MSIs
	  beyond this number are out of S-mode's reach.

config MPXY_RPMI_EVENT_BUF_SIZE
	int "Notification event buffer per RPMI channel (bytes)"
	depends on MPXY_RPMI
	default 512
	help
	  Events the PuC sent and S-mode has not fetched yet. When it is
	  full, further events are counted as lost. A multiple of 4.

endif
