menuconfig SBI
	bool "SBI (Supervisor Binary Interface)"
	default y
	help
	  RISC-V SBI implementation exposed to S-mode software. The base,
	  TIME, IPI, RFENCE, HSM and SRST extensions are always built; each
	  reports itself through the probe call only when its backend (timer,
	  IPI or reset driver) is there. Every extension is its own service.

if SBI

config SBI_IMPL_ID
	hex "SBI implementation ID"
	default 0xff
	help
	  Value returned by sbi_get_impl_id(). IDs are allocated in the SBI
	  specification; 0xff is a placeholder until one is registered.

config SBI_IMPL_VERSION
	hex "SBI implementation version"
	default 0x00000100

config SBI_SSE
	bool "Supervisor software events extension (SSE)"
	default y
	help
	  Events injected into S-mode ahead of anything S-mode can mask.
	  Sources so far: the software injected local and global events.

config SBI_DBTR
	bool "Debug triggers extension (DBTR)"
	default y
	help
	  Hardware breakpoints and watchpoints for S-mode, on harts with the
	  Sdtrig extension: address / data match triggers.

config SBI_DBTR_MAX_TRIGGERS
	int "Most triggers per hart the monitor manages"
	depends on SBI_DBTR
	range 1 64
	default 16

config SBI_SUSP
	bool "System suspend extension (SUSP)"
	help
	  Suspend to RAM as an M-mode wait for an S-mode interrupt, with all
	  other harts stopped. For platforms (and simulators) without a
	  deeper system sleep state of their own.

config SBI_PMU
	bool "Performance monitoring unit extension (PMU)"
	default y
	select LIBFDT
	help
	  Hardware counters (cycles and instructions; the programmable ones
	  as far as the "riscv,pmu" device tree node maps events to them) and
	  firmware counters for what the monitor does on S-mode's behalf.

config SBI_DBCN
	bool "Debug console extension (DBCN)"
	default y

config SBI_LEGACY
	bool "Legacy v0.1 extensions (EIDs 0x00-0x08)"
	default y
	help
	  set_timer, console putchar/getchar, clear/send IPI, remote fences
	  and shutdown as defined before SBI v0.2. Deprecated by the
	  specification; current kernels do not need them.

endif
