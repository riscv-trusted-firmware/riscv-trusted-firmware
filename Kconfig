#
# Top-level Kconfig. Order matters: platforms are sourced first so that a
# platform can provide defaults for symbols owned by drivers, services, etc.
# (a 'default' listed first wins).

mainmenu "$(PROJECT_NAME) $(PROJECT_VERSION) configuration"

source "platform/Kconfig"
source "arch/Kconfig"

menu "General"

choice
	prompt "Optimisation level"
	default OPTIMIZE_SIZE

config OPTIMIZE_SIZE
	bool "Size (-Os)"

config OPTIMIZE_SPEED
	bool "Speed (-O2)"

config OPTIMIZE_DEBUG
	bool "Debug (-Og)"

endchoice

config DEBUG_INFO
	bool "Compile with debug info (-g3)"
	default y

config WERROR
	bool "Treat warnings as errors"
	default y

config STACK_PROTECTOR
	bool "Stack canaries (-fstack-protector-strong)"
	default y
	help
	  A function with an array or an address taken of a local checks a
	  canary before it returns, and the monitor panics when it is gone:
	  an overflow of a buffer on the stack stops the machine instead of
	  choosing the return address. The canary is a constant with a zero
	  byte in it, the same in every build: it stops the overflow that
	  runs on from a buffer, not the write that knows where it goes.

config STACK_USAGE
	bool "Emit per-function stack usage (.su files)"

config STACK_SIZE
	hex "Per-hart stack size"
	default 0x2000

config LOG_LEVEL
	int "Log level (0=none, 1=error, 2=warn, 3=info, 4=debug)"
	range 0 4
	default 3

config BOOT_HANDOVER
	bool "Take a hand-over block from the previous stage (a2)"
	default y
	help
	  The previous boot stage may pass, in a2, a block that says where the
	  next stage after this one is, in which mode it starts and which hart
	  is to boot: what U-Boot SPL, EDK2, coreboot and QEMU (-kernel) hand
	  to the M-mode firmware they start. See include/handover.h. Without
	  a block the configured addresses apply. Say n when a2 is not to be
	  looked at.

endmenu

source "images/Kconfig"
source "lib/Kconfig"
source "drivers/Kconfig"
source "services/Kconfig"
