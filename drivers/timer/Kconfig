menu "Timer"

config TIMER_ACLINT_MTIMER
	bool "RISC-V ACLINT MTIMER / SiFive CLINT timer"
	help
	  Found in the device tree ("riscv,aclint-mtimer", "riscv,clint0",
	  "sifive,clint0"). The addresses below apply when no node matches.

if TIMER_ACLINT_MTIMER

config TIMER_ACLINT_MTIMER_MTIME_ADDR
	hex "MTIME register address"
	default 0x0

config TIMER_ACLINT_MTIMER_MTIMECMP_ADDR
	hex "MTIMECMP register array address"
	default 0x0

config TIMER_ACLINT_MTIMER_FIRST_HART
	int "Hart id of the first MTIMECMP register"
	default 0

endif

endmenu
