menu "System reset"

config RESET_SIFIVE_TEST
	bool "SiFive test finisher (QEMU virt / sifive_u power-off and reboot)"

config RESET_SIFIVE_TEST_ADDR
	hex "Register address when the device tree has no node for it"
	default 0x0
	depends on RESET_SIFIVE_TEST

config RESET_SYSCON
	bool "Generic syscon-poweroff / syscon-reboot"
	help
	  A value written to a system controller register, as the device
	  tree describes it.

config RESET_HTIF
	bool "HTIF (leaving a simulation)"
	select SERIAL_HTIF

config RESET_GPIO
	bool "gpio-poweroff / gpio-restart"
	depends on GPIO

config RESET_WDT
	bool "Watchdog reset (Allwinner D1, Andes ATCWDT200)"

config RESET_RPMI
	bool "RPMI SYSTEM_RESET service group"
	depends on RPMI
	help
	  Shutdown and reboot through the platform microcontroller. Preferred
	  over the other reset devices for the reset types the PuC supports.

endmenu
