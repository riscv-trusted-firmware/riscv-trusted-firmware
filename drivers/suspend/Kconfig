menu "System suspend"

config SUSPEND_RPMI
	bool "RPMI SYSTEM_SUSPEND service group"
	depends on RPMI
	help
	  Tell the platform microcontroller when S-mode suspends the system
	  (SBI SUSP), so that it can take the platform down once the last
	  hart waits for an interrupt.

endmenu
