menu "Inter-processor interrupts"

config IPI_ACLINT_MSWI
	bool "RISC-V ACLINT MSWI / SiFive CLINT software interrupts"
	help
	  Found in the device tree ("riscv,aclint-mswi", "riscv,clint0",
	  "sifive,clint0"). The address below applies when no node matches.

if IPI_ACLINT_MSWI

config IPI_ACLINT_MSWI_ADDR
	hex "MSIP register array address"
	default 0x0

config IPI_ACLINT_MSWI_SIZE
	hex "Size of the MSWI register block"
	default 0x4000
	help
	  Kept from S/U-mode. The SiFive CLINT has its timer right behind.

config IPI_ACLINT_MSWI_FIRST_HART
	int "Hart id of the first MSIP register"
	default 0

endif

config IPI_ANDES_PLICSW
	bool "Andes PLICSW software interrupts"

endmenu
