menu "RPMI (RISC-V Platform Management Interface)"

config RPMI
	bool "RPMI client"
	help
	  Talk to a platform microcontroller: the message protocol, the
	  request / acknowledgment engine and the notification path. Needs a
	  transport below.

if RPMI

config RPMI_MAX_DATA_LEN
	int "Largest message data the client handles (bytes)"
	default 248
	help
	  An upper bound for the transport's own limit (slot size minus the
	  8-byte header); sizes the client's bounce buffer. A multiple of 4.

config RPMI_TIMEOUT_US
	int "Send and acknowledgment timeout (microseconds)"
	default 100000

config RPMI_SHMEM
	bool "Shared memory transport"

if RPMI_SHMEM

config RPMI_SHMEM_MAX_INSTANCES
	int "Most shared memory transports the monitor drives"
	default 2
	help
	  The transports are "riscv,rpmi-shmem-mbox" nodes of the device
	  tree: queue addresses, slot size and doorbell come from there.

config RPMI_SHMEM_PROTECT
	bool "Hide the shared memory from S/U-mode"
	default y
	help
	  The queues and the doorbell become machine-only memory regions.
	  S-mode then reaches the PuC through MPXY only. Shared memory that
	  lies in RAM is added to /reserved-memory of the next stage either
	  way.

endif

endif

endmenu
