if PLAT_QEMU_VIRT

config PLATFORM_DIR
	default "qemu/virt"

config PLATFORM_NAME
	default "QEMU virt"

config PLATFORM_HART_COUNT
	default 8

config PLATFORM_FW_START
	default 0x80000000

config LOADER_NEXT_STAGE_ADDR
	default 0x80200000

# Where QEMU's -kernel puts an image: 2 MiB into RAM on RV64, 4 MiB on RV32.
# With the loader in front, the monitor itself sits at 2 MiB.
config MONITOR_NEXT_STAGE_ADDR
	default 0x80400000 if IMAGE_LOADER || RISCV_RV32I
	default 0x80200000

config QEMU_VIRT_RAM_SIZE
	hex "RAM size passed to QEMU (bytes)"
	default 0x8000000

# Defaults for symbols owned by drivers.
config SERIAL_UART8250_BASE
	default 0x10000000

config SERIAL_UART8250_CLOCK
	default 3686400

config SERIAL_UART8250_REG_SHIFT
	default 0

config SERIAL_UART8250_REG_WIDTH
	default 1

# CLINT at 0x2000000: MSWI, then MTIMER (mtimecmp +0x4000, mtime +0xbff8).
config IPI_ACLINT_MSWI_ADDR
	default 0x2000000

config TIMER_ACLINT_MTIMER_MTIMECMP_ADDR
	default 0x2004000

config TIMER_ACLINT_MTIMER_MTIME_ADDR
	default 0x200bff8

config RESET_SIFIVE_TEST_ADDR
	default 0x100000

config SBI_SUSP
	default y

config QEMU_VIRT_DOMAINS
	bool "Describe domains, for the SBI test payload"
	depends on DOMAINS && IMAGE_SBITEST
	help
	  Adds a domain configuration to the device tree: the test payload
	  runs in a domain without access to the memory of two others, one
	  it enters on its own harts and one that has the last hart to
	  itself. All three run parts of the test payload's image.

config QEMU_VIRT_DOMAINS_MEM
	hex "Memory for the test domains (2 MiB and a page)"
	depends on QEMU_VIRT_DOMAINS
	default 0x80a00000

config QEMU_VIRT_RPMI
	bool "Describe an RPMI transport in RAM, for a PuC model"
	default y if IMAGE_SBITEST
	select RPMI
	select RPMI_SHMEM
	select MPXY
	select RESET_RPMI
	select SUSPEND_RPMI
	select HSM_RPMI
	select CPPC_RPMI
	help
	  QEMU virt has no platform microcontroller. With this the platform
	  adds to the device tree what a platform with one would have there:
	  an RPMI shared memory transport (16 KiB of RAM), MPXY channels for
	  the clock and voltage service groups, and the RPMI users for reset,
	  suspend, hart power and CPPC. The drivers then find all of it like
	  on real hardware. The SBI test payload runs a PuC model on one hart
	  to test it end to end; with no PuC listening the RPMI users stand
	  aside (after a timeout each time they are asked).

if QEMU_VIRT_RPMI

config QEMU_VIRT_RPMI_CHANNEL_BASE
	hex "First MPXY channel id"
	default 0x1000

# Clear of everything QEMU loads with at least 128 MiB of RAM.
config QEMU_VIRT_RPMI_SHMEM_BASE
	hex "Address of the four queues"
	default 0x83f00000

config QEMU_VIRT_RPMI_QUEUE_SIZE
	hex "Size of each queue"
	default 0x1000

config QEMU_VIRT_RPMI_SLOT_SIZE
	int "Slot size"
	default 64

# The PuC model runs in S-mode.
config RPMI_SHMEM_PROTECT
	default n

endif

endif
